{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nunomaduro/laravel-starter-kit-inertia-react",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2.0",
        "inertiajs/inertia-laravel": "^2.0.21",
        "laravel/fortify": "^1.41.0",
        "laravel/framework": "^12.71.0",
        "laravel/nightwatch": "^1.30.6",
        "laravel/tinker": "^2.11.1",
        "laravel/wayfinder": "^0.1.20",
        "spatie/laravel-activitylog": "^4.12.3",
        "spatie/laravel-data": "^4.23.1",
        "spatie/laravel-permission": "^6.25",
        "spatie/laravel-query-builder": "^6.4.4"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.7.3",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.14.0",
        "laravel/boost": "^1.8.13",
        "laravel/pail": "^1.2.7",
        "laravel/pint": "^1.32.1",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "nunomaduro/phpinsights": "^2.14.2",
        "phpunit/phpunit": "^11.5.57",
        "rector/rector": "^2.8.4",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan clear",
            "@update:requirements"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "update:requirements": [
            "composer bump",
            "npx npm-check-updates -u"
        ],
        "lint": [
            "./vendor/bin/rector",
            "./vendor/bin/pint --parallel",
            "npm run lint"
        ],
        "test:type-coverage": "./vendor/bin/pest --type-coverage --min=85.0",
        "test:lint": [
            "./vendor/bin/pint --parallel --test",
            "./vendor/bin/rector --dry-run",
            "npm run test:lint"
        ],
        "test:unit": "./vendor/bin/pest --parallel --coverage --min=85.0",
        "test:types": [
            "./vendor/bin/phpstan",
            "npm run test:types"
        ],
        "test": [
            "@test:type-coverage",
            "@test:unit",
            "@test:lint",
            "@test:types"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
